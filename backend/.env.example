# ---------------------------------------------------------------------
# 复制成 .env 后按需修改。.env 已在 .gitignore 里，切勿提交真实密码。
# ---------------------------------------------------------------------

# 本地开发：零配置的 SQLite（文件生成在 backend/dev.db）
DATABASE_URL=sqlite:///./dev.db

# 在线 MySQL：主机、端口和库名使用服务商控制台提供的值；密码中的特殊字符需 URL 编码。
# DATABASE_URL=mysql+pymysql://用户名:已编码密码@主机:端口/数据库名?charset=utf8mb4
# DB_SSL=0
# TiDB Cloud Starter（MySQL Compatible）使用同一个驱动，公网连接须 DB_SSL=1。
# 完整示例见 tidb.env.example；不要将 Aiven 的 CA 用于 TiDB。
# 若服务商要求 TLS，设 DB_SSL=1；自签 CA 时下载证书并设置绝对路径：
# DB_SSL_CA=E:/studywork/软工/backend/certs/ca.pem

# 权重衰减指数 α：越大，高积分同学被点到的概率降得越明显；0 表示等概率
ALPHA=1.0

# 积分规则（改这里不用改代码，也方便博客里做「参数敏感性」实验）
POINT_ARRIVE=1.0
POINT_REPEAT_OK=0.5
POINT_REPEAT_FAIL=-1.0
ANSWER_MIN=0.5
ANSWER_MAX=3.0

# 每被点名 N 次获得 1 次点名转移权；设 0 关闭这个玩法
TRANSFER_EVERY=2

# 启动时自动建表（已用 schema.sql 建过表可以设 0）
AUTO_CREATE_TABLES=1

# 允许跨域的前端地址，多个用逗号分隔；"*" 表示不限制（演示够用）
CORS_ORIGINS=*

# 教师管理口令，所有 /api 接口必须传 X-Teacher-Key。留空时拒绝业务请求。
# 本机安装时可运行 python scripts/generate_teacher_key.py 自动生成并写入本地 .env。
TEACHER_API_KEY=
