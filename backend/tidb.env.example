# TiDB Cloud Starter / MySQL Compatible 配置样例，全部为占位符。
# 本地 .env 已存在，不要直接覆盖；连接值准备好后再替换对应配置项。
# 用户名、主机、端口、库名均以控制台 Connect 中提供的值为准。
# 密码中的特殊字符需要 URL 编码；真实密码只保存在本地 .env。
DATABASE_URL=mysql+pymysql://完整用户名:URL编码后的密码@实际主机:实际端口/test?charset=utf8mb4
DB_SSL=1
DB_SSL_CA=
AUTO_CREATE_TABLES=1
ALPHA=1.0
CORS_ORIGINS=*
